# Copy to .env and edit. The real .env is ignored by Git.
# Authentication: auto (use cache or show menu), qr, credentials, cache.
AUTH_METHOD=auto

# Used for Credentials, and to avoid accidentally reusing another account's cache.
STEAM_USERNAME=

# SECURITY WARNING: storing a Steam password in plaintext is risky.
# Prefer hidden console input instead. Uncomment ONLY if you accept the risk.
# STEAM_PASSWORD=""

# Windows-only: DPAPI-encrypted token cache. No plaintext fallback on Linux/macOS.
CACHE_SESSION=true

# Undocumented GC field. Usually leave empty.
DEADLOCK_LOCATION=
